{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ahc-control-centre",
  "main": "src/index.js",
  "compatibility_date": "2026-07-29",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "AHC_ANALYTICS_DB",
      "database_name": "ahc-analytics",
      "database_id": "e28f3826-1dfd-4fed-af1c-ea129f3503b2",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["20 18 * * *"]
  },
  "vars": {
    "SITE_ORIGIN": "https://australianhomecollective.com.au",
    "SEARCH_CONSOLE_SITE_URL": "sc-domain:australianhomecollective.com.au",
    "ACCESS_TEAM_DOMAIN": "REPLACE_WITH_TEAM_NAME.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD"
  }
}
