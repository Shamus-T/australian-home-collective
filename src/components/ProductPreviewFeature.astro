---
import { getGuideCardMetadata } from "../data/guideMetadata";
const href = "/guides/fisher-paykel-precision-fit-fridge-preview/";
const guide = getGuideCardMetadata(href)!;
---

<section class="section product-preview-section" data-homepage-product-preview aria-labelledby="product-preview-title">
  <div class="container">
    <a class="product-preview-feature" href={href}>
      <div class="preview-scene">
        <img src={guide.image} alt={guide.imageAlt} width="833" height="1000" loading="eager" decoding="async" />
        <span class="preview-gap-line" aria-hidden="true"></span>
        <span class="preview-gap-label">10 mm each side</span>
        <span class="preview-scene-credit">Product image: Fisher &amp; Paykel website · Illustrative setting</span>
      </div>
      <div class="preview-feature-copy">
        <p class="eyebrow">First look · Kitchen</p>
        <h2 id="product-preview-title">{guide.title}</h2>
        <p>A closer look at the kitchen fit, water and ice features, running costs and questions to resolve before pre-ordering.</p>
        <span class="preview-feature-link">Read the preview <span aria-hidden="true">→</span></span>
        <div class="preview-clearance-detail">
          <span class="preview-detail-label">Side clearance · enlarged diagram</span>
          <svg viewBox="0 0 300 47" role="img" aria-label="10 millimetre side gap between cabinet and fridge">
            <rect x="5" y="8" width="94" height="32" fill="#334653" />
            <rect x="201" y="8" width="94" height="32" fill="#7f8384" />
            <text x="52" y="28" fill="white" text-anchor="middle" font-size="11">Cabinet</text>
            <text x="248" y="28" fill="white" text-anchor="middle" font-size="11">Fridge</text>
            <path d="M103 28 H197 M109 24 L103 28 L109 32 M191 24 L197 28 L191 32" fill="none" stroke="#222c29" stroke-width="1.5" />
            <text x="150" y="19" text-anchor="middle" font-size="14" font-weight="bold">10 mm</text>
          </svg>
          <span class="preview-detail-note">Side gap only. See the article for top-clearance guidance.</span>
        </div>
      </div>
    </a>
  </div>
</section>

<style>
  .product-preview-section { padding: 32px 0 44px; background: #f4efe5; }
  .product-preview-feature { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr); overflow: hidden; background: #222c29; color: #fffaf0; text-decoration: none; border-radius: 10px; box-shadow: 0 14px 32px #30271924; }
  .preview-scene { position: relative; align-self: center; min-width: 0; aspect-ratio: 3 / 2; background: #3b342d url('/images/guides/precision-fit-blue-white-kitchen.webp') center / cover no-repeat; }
  /* Position uses the visible appliance bounds inside the transparent 833 × 1000 source. */
  .preview-scene img { position: absolute; height: 86.3%; width: auto; max-width: none; left: 38.31%; top: 4%; transform: translateX(-50%); object-fit: contain; }
  .preview-scene-credit { position: absolute; bottom: 0; left: 0; right: 0; padding: 10px 14px; background: #171815c9; color: #f2ede4; font-size: 0.66rem; line-height: 1.4; text-align: center; }
  .preview-gap-label { position: absolute; left: 61%; top: 27%; padding: 7px 8px; border: 1px solid #dec084; background: #222c29ed; color: #fff; font: bold 10px/12px Arial, sans-serif; }
  .preview-gap-line { position: absolute; left: 53.15%; width: 7.85%; top: calc(27% + 14px); height: 1px; background: #dec084; }
  .preview-gap-line::before { content: ""; position: absolute; left: -4px; top: -4px; width: 8px; height: 8px; border: 1.5px solid #dec084; border-radius: 50%; }
  .preview-clearance-detail { margin-top: 14px; padding: 9px 10px; background: #f4efe5; color: #222c29; border-radius: 4px; font-family: Arial, sans-serif; }
  .preview-detail-label { display: block; font-size: 0.6rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .preview-clearance-detail svg { display: block; width: 100%; height: 47px; }
  .preview-detail-note { display: block; font-size: 0.6rem; line-height: 1.4; color: #505950; }
  .preview-feature-copy { align-self: center; padding: 26px; }
  .preview-feature-copy .eyebrow { color: #dec084; margin: 0 0 12px; font-size: 0.7rem; letter-spacing: 0.14em; }
  .preview-feature-copy h2 { color: #fffaf0; font-size: clamp(1.6rem, 2.1vw, 1.875rem); line-height: 1.15; margin: 0 0 12px; }
  .preview-feature-copy > p:not(.eyebrow) { color: #e3e2d7; font-size: 0.9rem; line-height: 1.45; margin: 0 0 14px; }
  .preview-feature-link { display: inline-flex; align-items: center; gap: 22px; padding-bottom: 5px; color: #edd398; border-bottom: 1px solid #ae9360; font-weight: 700; }
  .product-preview-feature:hover .preview-feature-link { color: #fff; border-color: #fff; }
  .product-preview-feature:focus-visible { outline: 3px solid #ad762b; outline-offset: 5px; }
  @media (max-width: 1000px) {
    .product-preview-feature { grid-template-columns: minmax(0, 1fr); }
    .product-preview-section { padding: 22px 0 30px; }
    .preview-feature-copy { padding: 26px; }
    .preview-feature-copy h2 { font-size: 1.8rem; }
  }
</style>
