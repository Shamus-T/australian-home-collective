---
import { getGuideCardMetadata } from "../data/guideMetadata";

interface Props {
  href: string;
  title: string;
  description: string;
  meta?: string;
  image?: string;
  imageAlt?: string;
  imagePosition?: string;
  headingLevel?: 2 | 3;
  className?: string;
  preferProvidedMetadata?: boolean;
  imageSources?: { avif: string; webp: string };
}

const {
  href,
  title,
  description,
  meta,
  image,
  imageAlt = "",
  imagePosition = "center",
  headingLevel = 3,
  className,
  preferProvidedMetadata = false,
  imageSources,
} = Astro.props;
const articleMetadata = href.startsWith("/guides/") ? getGuideCardMetadata(href) : undefined;

if (href.startsWith("/guides/") && !articleMetadata) {
  throw new Error(`GuideCard points to an inactive or unknown guide: ${href}`);
}

const resolvedTitle = preferProvidedMetadata ? title : articleMetadata?.title ?? title;
const resolvedImage = preferProvidedMetadata ? image : articleMetadata?.image ?? image;
const resolvedImageAlt = preferProvidedMetadata ? imageAlt : articleMetadata?.imageAlt ?? imageAlt;
const resolvedImagePosition = preferProvidedMetadata
  ? imagePosition
  : articleMetadata?.imagePosition ?? imagePosition;
const HeadingTag = headingLevel === 2 ? "h2" : "h3";
---

<article
  class:list={[
    "guide-card",
    resolvedImage && "has-image",
    meta === "Category" && "category-card",
    className,
  ]}
>
  <a href={href}>
    {resolvedImage && (
      <picture style="display: contents;">
      {imageSources && <>
        <source type="image/avif" srcset={imageSources.avif} sizes="(max-width: 700px) 100vw, (max-width: 1000px) 50vw, 380px" />
        <source type="image/webp" srcset={imageSources.webp} sizes="(max-width: 700px) 100vw, (max-width: 1000px) 50vw, 380px" />
      </>}
      <img
        class="card-image"
        src={resolvedImage}
        alt={resolvedImageAlt}
        width="900"
        height="620"
        loading="lazy"
        decoding="async"
        draggable="false"
        style={`object-position: ${resolvedImagePosition};`}
      />
      </picture>
    )}
    {meta && <p class="meta">{meta}</p>}
    <HeadingTag>{resolvedTitle}</HeadingTag>
    <p>{description}</p>
  </a>
</article>
