---
import { getGuideCardMetadata } from "../data/guideMetadata";

interface Props {
  href: string;
  title: string;
  description: string;
  meta?: string;
  image?: string;
  imageAlt?: string;
  imagePosition?: string;
  headingLevel?: 2 | 3;
  className?: string;
  preferProvidedMetadata?: boolean;
  imageSources?: { avif: string; webp: string };
}

const {
  href,
  title,
  description,
  meta,
  image,
  imageAlt = "",
  imagePosition = "center",
  headingLevel = 3,
  className,
  preferProvidedMetadata = false,
  imageSources,
} = Astro.props;
const articleMetadata = href.startsWith("/guides/") ? getGuideCardMetadata(href) : undefined;

if (href.startsWith("/guides/") && !articleMetadata) {
  throw new Error(`GuideCard points to an inactive or unknown guide: ${href}`);
}

const resolvedTitle = preferProvidedMetadata ? title : articleMetadata?.title ?? title;
const resolvedImage = preferProvidedMetadata ? image : articleMetadata?.image ?? image;
const resolvedImageAlt = preferProvidedMetadata ? imageAlt : articleMetadata?.imageAlt ?? imageAlt;
const resolvedImagePosition = preferProvidedMetadata
  ? imagePosition
  : articleMetadata?.imagePosition ?? imagePosition;
const HeadingTag = headingLevel === 2 ? "h2" : "h3";
---

<article
  class:list={[
    "guide-card",
    resolvedImage && "has-image",
    articleMetadata?.imagePresentation === "product" && "product-image",
    meta === "Category" && "category-card",
    className,
  ]}
>
  <a href={href}>
    {resolvedImage && (
      <picture style="display: contents;">
      {imageSources && <>
        <source type="image/avif" srcset={imageSources.avif} sizes="(max-width: 700px) 100vw, (max-width: 1000px) 50vw, 380px" />
        <source type="image/webp" srcset={imageSources.webp} sizes="(max-width: 700px) 100vw, (max-width: 1000px) 50vw, 380px" />
      </>}
      <img
        class="card-image"
        src={resolvedImage}
        alt={resolvedImageAlt}
        width={articleMetadata?.imagePresentation === "product" ? 833 : 900}
        height={articleMetadata?.imagePresentation === "product" ? 1000 : 620}
        loading="lazy"
        decoding="async"
        draggable="false"
        style={`object-position: ${resolvedImagePosition};`}
      />
      </picture>
    )}
    {meta && <p class="meta">{meta}</p>}
    <HeadingTag>{resolvedTitle}</HeadingTag>
    <p>{description}</p>
  </a>
</article>

<style is:global>
  .guide-card.has-image.product-image a { grid-template-rows: 230px auto auto 1fr; gap: 12px; background: #edf0e8; padding: 24px; }
  .guide-card.has-image.product-image a::before { display: none; }
  .guide-card.has-image.product-image .card-image { position: static; grid-row: 1; z-index: auto; width: 100%; height: 230px; object-fit: contain; filter: none; transform: none; }
  .guide-card.has-image.product-image .meta { grid-row: 2; }
  .guide-card.has-image.product-image h3, .guide-card.has-image.product-image h2 { grid-row: 3; min-height: 0; }
  .guide-card.has-image.product-image p:not(.meta) { grid-row: 4; }
  .guide-card.has-image.product-image h3, .guide-card.has-image.product-image h2, .guide-card.has-image.product-image p { color: #213c31; text-shadow: none; }
</style>
