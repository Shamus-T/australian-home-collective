---
import {
  getApprovedProductsForGuide,
  getCommercialSectionId,
  getRetailersForProduct,
  researchOutcomeLabels,
} from "../lib/commercial-products";
import ManufacturerPrice from "./ManufacturerPrice.astro";
import { Fragment as NoWrapper } from "astro/jsx-runtime";
import CommercialRetailerLinks from "./CommercialRetailerLinks.astro";
import CommercialProductNameLink from "./CommercialProductNameLink.astro";
import {
  AFFILIATE_CLICK_ENDPOINT,
  ANALYTICS_SESSION_KEY,
} from "../scripts/affiliate-click-tracker.js";

interface Props {
  guidePath: string;
  title?: string;
  intro?: string;
  variant?: "solution" | "quick" | "comparison";
  accessoryProductIds?: string[];
  accessoryTitle?: string;
  accessoryIntro?: string;
  shortlist?: Record<string, string>;
  comparisonDetails?: Record<string, { reason: string; fit: string; tradeoff: string; minimumWidthMm?: number; decisionLabel?: string; jumpLabel?: string }>;
  compactComparison?: boolean;
}

const {
  guidePath,
  title = "Products currently worth comparing",
  intro = "These options have been checked against the measurements and buying questions in this guide.",
  variant = "solution",
  accessoryProductIds = [],
  shortlist,
  comparisonDetails = {},
  compactComparison = false,
  accessoryTitle = "Optional setup accessories",
  accessoryIntro = "These do not replace the appliance. Check what is included and buy an extra only when it solves a specific setup problem.",
} = Astro.props;

const products = getApprovedProductsForGuide(guidePath).filter(product => product.presentation !== "comparison-only");
const retailers = new Map(products.map((product) => [product.id, getRetailersForProduct(product)]));
const hasAffiliateLinks = [...retailers.values()].some((offers) => offers.some((offer) => offer.affiliate));
const hasMultipleRetailers = [...retailers.values()].some((offers) => offers.length > 1);
const sectionId = getCommercialSectionId(guidePath);
const primaryProducts = products.filter(product => !accessoryProductIds.includes(product.id));
const compareByWidth = primaryProducts.length > 0 && primaryProducts.every(product => comparisonDetails[product.id]?.minimumWidthMm);
const compareBySetup = primaryProducts.length > 0 && primaryProducts.every(product => comparisonDetails[product.id]?.decisionLabel && comparisonDetails[product.id]?.jumpLabel);
const showFitNotes = compareByWidth || compareBySetup;
const comparisonProducts = compareByWidth
  ? [...primaryProducts].sort((a, b) => comparisonDetails[a.id].minimumWidthMm! - comparisonDetails[b.id].minimumWidthMm!)
  : primaryProducts;
const accessories = products.filter(product => accessoryProductIds.includes(product.id));
if (accessoryProductIds.some(id => !accessories.some(product => product.id === id)) || (accessories.length && !primaryProducts.length)) {
  throw new Error('Accessory groups require valid local product IDs and at least one primary product.');
}
const featured = shortlist ? primaryProducts.filter(product => Object.hasOwn(shortlist, product.id)) : primaryProducts;
if (shortlist && (featured.length !== Object.keys(shortlist).length || featured.length < 1 || featured.length > 6)) {
  throw new Error("A shortlist requires one to six distinct approved products from this guide.");
}
const further = shortlist ? primaryProducts.filter(product => !Object.hasOwn(shortlist, product.id)) : [];
const productGroups = [featured, ...(further.length ? [further] : []), ...(accessories.length ? [accessories] : [])];
const showComparison = variant === "comparison" && primaryProducts.length > 1;
const displayVariant = variant === "comparison" && !showComparison ? "quick" : variant;

const formatDate = (date: string) =>
  new Intl.DateTimeFormat("en-AU", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "Australia/Brisbane",
  }).format(new Date(`${date}T00:00:00+10:00`));
---

{products.length > 0 && (
  <section
    class:list={[`commercial-product-block commercial-product-block--${displayVariant}`, { 'commercial-product-block--appliance': Object.keys(comparisonDetails).length > 0, 'commercial-product-block--compact': compactComparison, 'commercial-product-block--widths': compareByWidth, 'commercial-product-block--fit': showFitNotes }]}
    aria-labelledby={sectionId}
    data-commercial-product-block
    data-accessory-product-ids={accessoryProductIds.join(" ")}
    data-affiliate-endpoint={AFFILIATE_CLICK_ENDPOINT}
    data-analytics-session-key={ANALYTICS_SESSION_KEY}
  >
    <h2 id={sectionId}>{title}</h2>
    <p class="commercial-product-context" data-commercial-solution-context>{intro}</p>
    {hasAffiliateLinks && (
      <p class="commercial-product-disclosure" aria-label="Affiliate disclosure">
        Some links below are affiliate links. We may earn commission at no extra cost to you.{" "}
        {hasMultipleRetailers && "For each product, higher-paying partners appear first. "}
        <a href="/affiliate-disclosure/">Learn more.</a>
      </p>
    )}
    {showComparison && (
      <>
      <p class="commercial-comparison-hint" id={`${sectionId}-hint`}>Compare the fit, main drawback and retailer availability for each option.</p>
      {compareBySetup && (
        <nav class="setup-routes" aria-label="Jump to a model by setup">
          {comparisonProducts.map(product => <a href={`#compare-${product.id}`}>{comparisonDetails[product.id].jumpLabel}</a>)}
          <slot name="setup-link" />
        </nav>
      )}
      {compareByWidth && (
        <nav class="opening-widths" aria-label="Jump to a model by minimum opening width">
          <span>Minimum opening width</span>
          {comparisonProducts.map(product => <a href={`#compare-${product.id}`} aria-label={`${comparisonDetails[product.id].minimumWidthMm} mm opening: ${product.name}`}>{comparisonDetails[product.id].minimumWidthMm} mm</a>)}
        </nav>
      )}
      <div class="commercial-product-comparison-wrap" role="region" aria-label={`${title} comparison`} aria-describedby={`${sectionId}-hint`} tabindex="0">
        <table class="commercial-product-comparison">
          <caption>Compare these researched options&nbsp;</caption>
          <thead><tr><th scope="col">Option&nbsp;</th><th scope="col">May suit&nbsp;</th><th scope="col">Check first&nbsp;</th><th scope="col">Retailer prices and availability</th></tr></thead>
          <tbody>
            {comparisonProducts.map((product) => (
              <tr id={`compare-${product.id}`}>
                <th scope="row">
                  {product.image && (
                    <img class="commercial-product-thumbnail" src={product.image.src}
                      srcset={product.image.srcSet} sizes="112px" alt=""
                      width={product.image.width} height={product.image.height}
                      loading="lazy" decoding="async" />
                  )}
                  <span class="commercial-comparison-identity">
                    {compareByWidth && <strong class="opening-width">{comparisonDetails[product.id].minimumWidthMm} mm minimum width&nbsp;</strong>}
                    {compareBySetup && <strong class="opening-width">{comparisonDetails[product.id].decisionLabel}&nbsp;</strong>}
                    <CommercialProductNameLink product={product} offer={retailers.get(product.id)![0]} />{" "}
                  {!showFitNotes && <span class="commercial-comparison-type">{product.productType}</span>}</span>
                </th>
                <td data-label="May suit">{comparisonDetails[product.id]?.reason ?? product.suitability.suits[0]}</td>
                <td class:list={[{ "fit-cell": showFitNotes }]} data-label="Check first">
                  {showFitNotes ? <details class="fit-notes">
                    <summary>Check installation details</summary>
                    <p>{comparisonDetails[product.id].fit} {comparisonDetails[product.id].tradeoff}</p>
                  </details> : comparisonDetails[product.id] ? <>
                    <strong>{comparisonDetails[product.id].fit}</strong><br />
                    {comparisonDetails[product.id].tradeoff}
                  </> : product.drawbacks[0]}
                </td>
                <td data-label={showFitNotes ? "Check price and postcode delivery" : "Retailer prices and availability"} id={showFitNotes ? `offer-${product.id}` : undefined}>
                  <CommercialRetailerLinks product={product} offers={retailers.get(product.id)!} placement="comparison" />
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      </>
    )}
    <slot name="after-comparison" />
    {showComparison && <h3 class="commercial-product-details-heading">More about each option</h3>}
    {shortlist && <nav class="shortlist-jumps" aria-label="Choose an appliance by task">
      {featured.map(product => <a href={`#product-${product.id}`}>{shortlist[product.id]}</a>)}
    </nav>}
    {productGroups.map(group => {
    const Wrapper = group === further ? "details" : NoWrapper;
    return (<Wrapper class={group === further ? "further-models" : undefined}>
    {group === further && <summary>Further models compared in this guide ({further.length})</summary>}
    {group === accessories && <>
      <h3 class="commercial-product-details-heading">{accessoryTitle}</h3>
      <p>{accessoryIntro}</p>
    </>}
    <div class="commercial-product-grid" data-product-count={group.length} data-product-role={group === accessories ? "accessory" : "primary"} data-research-shortlist={shortlist && group === featured ? "" : undefined}>
      {group.map((product) => (
        <article id={`product-${product.id}`} class="commercial-product-card" data-commercial-product-card>
          <p class="commercial-product-type">{shortlist?.[product.id] ?? product.productType}</p>
          <h3>{product.name}</h3>
          {product.image && (
            <figure class="commercial-product-media">
              <img src={product.image.src} srcset={product.image.srcSet}
                sizes="(max-width: 767px) calc(100vw - 80px), 360px"
                alt={product.image.alt} width={product.image.width} height={product.image.height}
                loading="lazy" decoding="async" />
              <figcaption>{product.image.credit}</figcaption>
            </figure>
          )}
          <p class="commercial-product-summary">{product.summary}</p>
          <ManufacturerPrice product={product} />
          <CommercialRetailerLinks product={product} offers={retailers.get(product.id)!} placement="card" />
          <div class="commercial-product-fit">
            <p><strong>Good fit for</strong><br />{product.suitability.suits[0]}</p>
            <p><strong>Check before buying</strong><br />{product.drawbacks[0]}</p>
          </div>
          <p class="commercial-product-outcome">{researchOutcomeLabels[product.researchOutcome!]}</p>
          <details class="commercial-product-disclosure-details">
            <summary class="commercial-product-details-toggle">More suitability and drawbacks</summary>
            <div
              class="commercial-product-details-content"
              id={`commercial-product-details-${product.id}`}
              aria-label={`${product.name} suitability and drawbacks`}
            >
              <p><strong>May suit:</strong> {product.suitability.suits.join("; ")}.</p>
              <p><strong>May not suit:</strong> {product.suitability.mayNotSuit.join("; ")}.</p>
              <div class="commercial-product-drawbacks">
                <p><strong>Drawbacks to consider:</strong></p>
                <ul>
                  {product.drawbacks.map((drawback) => <li>{drawback}</li>)}
                </ul>
              </div>
              <p class="commercial-product-reviewed">
                Evidence confidence: {product.evidenceConfidence}. Last reviewed{" "}
                {formatDate(product.lastReviewedOn!)}.{" "}
                {product.testingStatus === "hands-on-tested"
                  ? product.testingNotes
                  : "Research-based assessment; we have not tested this product firsthand."}
              </p>
            </div>
          </details>
        </article>
      ))}
    </div>
    {group === featured && <slot name="browse-products" />}
    </Wrapper>);})}
  </section>
)}

<script>
  import {
    AFFILIATE_CLICK_ENDPOINT,
    ANALYTICS_SESSION_KEY,
    createAffiliateClickTracker,
  } from "../scripts/affiliate-click-tracker.js";
  import {
    AFFILIATE_CLICK_EVENT_NAME,
    sendGoogleAnalyticsEvent,
  } from "../scripts/google-analytics.js";
  import { shouldTrackAnalytics } from "../scripts/analytics-preference.js";
  import { recordBuyingJourneyClick } from "../scripts/buying-journey-tracker.js";

  const analyticsSessionId = () => {
    try {
      const existing = sessionStorage.getItem(ANALYTICS_SESSION_KEY);
      if (existing) return existing;
      const created = crypto.randomUUID();
      sessionStorage.setItem(ANALYTICS_SESSION_KEY, created);
      return created;
    } catch {
      return "";
    }
  };

  const deviceType = () => {
    if (window.matchMedia("(max-width: 767px)").matches) return "mobile";
    if (window.matchMedia("(max-width: 1023px)").matches) return "tablet";
    return "desktop";
  };

  const sendAffiliateClick = (event: Record<string, string>) => {
    const payload = JSON.stringify(event);
    try {
      if (navigator.sendBeacon) {
        const accepted = navigator.sendBeacon(
          AFFILIATE_CLICK_ENDPOINT,
          new Blob([payload], { type: "application/json" }),
        );
        if (accepted) return;
      }
    } catch {
      // Best-effort analytics must never affect the retailer link.
    }

    fetch(AFFILIATE_CLICK_ENDPOINT, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: payload,
      credentials: "same-origin",
      keepalive: true,
    }).catch(() => {});
  };

  const recordAffiliateClick = (event: Record<string, string>, link: HTMLAnchorElement) => {
    sendAffiliateClick(event);
    recordBuyingJourneyClick(event, link);
    sendGoogleAnalyticsEvent(AFFILIATE_CLICK_EVENT_NAME, {
      affiliate_network: event.affiliateNetwork,
      guide_path: event.guidePath,
      item_id: event.productId,
      item_name: event.productName,
      link_domain: event.destinationHost,
      merchant: event.merchant,
    });
  };

  const affiliateClickTracker = createAffiliateClickTracker({
    recordEvent: recordAffiliateClick,
    pagePath: () => window.location.pathname,
    sessionId: analyticsSessionId,
    createEventId: () => crypto.randomUUID(),
    device: deviceType,
  });

  const recordAffiliateLink = (event: Event) => {
    if (!shouldTrackAnalytics()) return;
    if (!(event.target instanceof Element)) return;
    const link = event.target.closest('[data-commercial-link="affiliate"][data-affiliate-trackable="true"]');
    if (link instanceof HTMLAnchorElement) affiliateClickTracker.recordLink(link);
  };

  document.addEventListener("click", (event) => {
    if (event.button === 0) recordAffiliateLink(event);
  });
  document.addEventListener("auxclick", (event) => {
    if (event.button === 1) recordAffiliateLink(event);
  });

</script>

<style>
  .shortlist-jumps { display:flex; flex-wrap:wrap; gap:.5rem 1.4rem; margin:1rem 0 1.5rem; }
  .shortlist-jumps a { padding:.3rem 0; }
  .further-models { margin:1.4rem 0 0; }
  .further-models > summary { cursor:pointer; font-weight:700; padding:.7rem 0; color:var(--green-dark); }
  .opening-widths { display: flex; align-items: center; flex-wrap: wrap; column-gap: .7rem; margin-bottom: .5rem; }
  .opening-widths span, .opening-width { display: block; font-weight: 700; }
  .opening-widths a { display: inline-flex; align-items: center; min-height: 44px; }
  .setup-routes { display: flex; flex-wrap: wrap; gap: 0 1rem; margin-bottom: .5rem; }
  .setup-routes :global(a) { display: inline-flex; align-items: center; min-height: 44px; }
  .fit-notes { position: relative; z-index: 2; }
  .fit-notes summary { color: var(--green-dark); cursor: pointer; font-weight: 700; padding: .55rem 0; }
  .opening-width { color: var(--green-dark); }

  .commercial-product-block--appliance .commercial-product-comparison { min-width: 0; }
  .commercial-product-block--appliance .commercial-product-comparison thead th:last-child { width: 240px; }
  @media (max-width: 899px) {
    .commercial-product-block .commercial-product-comparison-wrap { overflow: visible; border: 0; }
    .commercial-product-block .commercial-product-comparison { min-width: 0; }
    .commercial-product-block .commercial-product-comparison,
    .commercial-product-block .commercial-product-comparison caption,
    .commercial-product-block .commercial-product-comparison tbody,
    .commercial-product-block .commercial-product-comparison tr,
    .commercial-product-block .commercial-product-comparison th,
    .commercial-product-block .commercial-product-comparison td { display: block; width: 100%; box-sizing: border-box; }
    .commercial-product-block .commercial-product-comparison thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .commercial-product-block .commercial-product-comparison tr { margin-bottom: 20px; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; }
    .commercial-product-block .commercial-product-comparison th { background: #e8eee5; border-top: 0; }
    .commercial-product-block .commercial-product-comparison td::before { content: attr(data-label); display: block; font-weight: 700; color: var(--green-dark); margin-bottom: 6px; }
    .commercial-product-block .commercial-product-comparison td:last-child { text-align: center; }
    .commercial-product-block--compact .commercial-product-comparison th { display: flex; align-items: center; gap: 12px; }
    .commercial-product-block--compact .commercial-product-thumbnail { width: 64px; height: 80px; flex: 0 0 64px; margin: 0; object-fit: contain; }
    .commercial-product-block--compact .commercial-comparison-identity { min-width: 0; }
  }
  @media (max-width: 767px) {
    .commercial-product-block--widths .opening-widths { gap: 0 .8rem; }
    .commercial-product-block--widths .opening-widths span { display: none; }
    .commercial-product-block--fit .commercial-product-comparison tbody tr { display: flex; flex-direction: column; }
    .commercial-product-block--fit .commercial-product-comparison tbody th { order: -3; }
    .commercial-product-block--fit .commercial-product-comparison .fit-cell { order: -1; padding-block: 0; }
    .commercial-product-block--fit .commercial-product-comparison .fit-cell::before { display: none; }
    .commercial-product-block--fit .commercial-product-comparison tbody td:last-child {
      order: -2;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 6px 10px;
    }
  }
  @media (min-width: 900px) {
    .commercial-product-grid[data-product-count="4"] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
