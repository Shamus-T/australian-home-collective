---
import {
  getApprovedProductsForGuide,
  getCommercialSectionId,
  getRetailersForProduct,
  researchOutcomeLabels,
} from "../lib/commercial-products";
import CommercialRetailerLinks from "./CommercialRetailerLinks.astro";
import {
  AFFILIATE_CLICK_ENDPOINT,
  ANALYTICS_SESSION_KEY,
} from "../scripts/affiliate-click-tracker.js";

interface Props {
  guidePath: string;
  title?: string;
  intro?: string;
  variant?: "solution" | "quick" | "comparison";
  accessoryProductIds?: string[];
}

const {
  guidePath,
  title = "Products currently worth comparing",
  intro = "These options have been checked against the measurements and buying questions in this guide.",
  variant = "solution",
  accessoryProductIds = [],
} = Astro.props;

const products = getApprovedProductsForGuide(guidePath);
const retailers = new Map(products.map((product) => [product.id, getRetailersForProduct(product)]));
const hasAffiliateLinks = [...retailers.values()].some((offers) => offers.some((offer) => offer.affiliate));
const hasMultipleRetailers = [...retailers.values()].some((offers) => offers.length > 1);
const sectionId = getCommercialSectionId(guidePath);
const primaryProducts = products.filter(product => !accessoryProductIds.includes(product.id));
const accessories = products.filter(product => accessoryProductIds.includes(product.id));
if (accessoryProductIds.some(id => !accessories.some(product => product.id === id)) || (accessories.length && !primaryProducts.length)) {
  throw new Error('Accessory groups require valid local product IDs and at least one primary product.');
}
const productGroups = [primaryProducts, ...(accessories.length ? [accessories] : [])];
const showComparison = variant === "comparison" && primaryProducts.length > 1;
const displayVariant = variant === "comparison" && !showComparison ? "quick" : variant;

const formatDate = (date: string) =>
  new Intl.DateTimeFormat("en-AU", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "Australia/Brisbane",
  }).format(new Date(`${date}T00:00:00+10:00`));
---

{products.length > 0 && (
  <section
    class={`commercial-product-block commercial-product-block--${displayVariant}`}
    aria-labelledby={sectionId}
    data-commercial-product-block
    data-accessory-product-ids={accessoryProductIds.join(" ")}
    data-affiliate-endpoint={AFFILIATE_CLICK_ENDPOINT}
    data-analytics-session-key={ANALYTICS_SESSION_KEY}
  >
    <h2 id={sectionId}>{title}</h2>
    <p class="commercial-product-context" data-commercial-solution-context>{intro}</p>
    {hasAffiliateLinks && (
      <p class="commercial-product-disclosure" aria-label="Affiliate disclosure">
        Some links below are affiliate links. We may earn commission at no extra cost to you.{" "}
        {hasMultipleRetailers && "For each product, higher-paying partners appear first. "}
        <a href="/affiliate-disclosure/">Learn more.</a>
      </p>
    )}
    {showComparison && (
      <>
      <p class="commercial-comparison-hint" id={`${sectionId}-hint`}>Compare the fit and main trade-off. On a small screen, scroll across the table for retailer links.</p>
      <div class="commercial-product-comparison-wrap" role="region" aria-label={`${title} comparison`} aria-describedby={`${sectionId}-hint`} tabindex="0">
        <table class="commercial-product-comparison">
          <caption>Compare these researched options</caption>
          <thead><tr><th scope="col">Option</th><th scope="col">May suit</th><th scope="col">Check first</th><th scope="col">Check current price</th></tr></thead>
          <tbody>
            {primaryProducts.map((product) => (
              <tr>
                <th scope="row">
                  {product.image && (
                    <img class="commercial-product-thumbnail" src={product.image.src}
                      srcset={product.image.srcSet} sizes="112px" alt=""
                      width={product.image.width} height={product.image.height}
                      loading="lazy" decoding="async" />
                  )}
                  <a href={`#product-${product.id}`}>{product.name}</a>{" "}
                  <span class="commercial-comparison-type">{product.productType}</span>
                </th>
                <td>{product.suitability.suits[0]}</td>
                <td>{product.drawbacks[0]}</td>
                <td>
                  <CommercialRetailerLinks product={product} offers={retailers.get(product.id)!} placement="comparison" />
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      </>
    )}
    {showComparison && <h3 class="commercial-product-details-heading">More about each option</h3>}
    {productGroups.map((group, index) => (<>
    {index > 0 && <>
      <h3 class="commercial-product-details-heading">Optional setup accessories</h3>
      <p>These do not replace the appliance. Check what is included and buy an extra only when it solves a specific setup problem.</p>
    </>}
    <div class="commercial-product-grid" data-product-role={index > 0 ? "accessory" : "primary"}>
      {group.map((product) => (
        <article id={`product-${product.id}`} class="commercial-product-card" data-commercial-product-card>
          <p class="commercial-product-type">{product.productType}</p>
          <h3>{product.name}</h3>
          {product.image && (
            <figure class="commercial-product-media">
              <img src={product.image.src} srcset={product.image.srcSet}
                sizes="(max-width: 767px) calc(100vw - 80px), 360px"
                alt={product.image.alt} width={product.image.width} height={product.image.height}
                loading="lazy" decoding="async" />
              <figcaption>{product.image.credit}</figcaption>
            </figure>
          )}
          <p class="commercial-product-summary">{product.summary}</p>
          <CommercialRetailerLinks product={product} offers={retailers.get(product.id)!} placement="card" />
          <div class="commercial-product-fit">
            <p><strong>Good fit for</strong><br />{product.suitability.suits[0]}</p>
            <p><strong>Check before buying</strong><br />{product.drawbacks[0]}</p>
          </div>
          <p class="commercial-product-outcome">{researchOutcomeLabels[product.researchOutcome!]}</p>
          <details class="commercial-product-disclosure-details">
            <summary class="commercial-product-details-toggle">More suitability and drawbacks</summary>
            <div
              class="commercial-product-details-content"
              id={`commercial-product-details-${product.id}`}
              aria-label={`${product.name} suitability and drawbacks`}
            >
              <p><strong>May suit:</strong> {product.suitability.suits.join("; ")}.</p>
              <p><strong>May not suit:</strong> {product.suitability.mayNotSuit.join("; ")}.</p>
              <div class="commercial-product-drawbacks">
                <p><strong>Drawbacks to consider:</strong></p>
                <ul>
                  {product.drawbacks.map((drawback) => <li>{drawback}</li>)}
                </ul>
              </div>
              <p class="commercial-product-reviewed">
                Evidence confidence: {product.evidenceConfidence}. Last reviewed{" "}
                {formatDate(product.lastReviewedOn!)}.{" "}
                {product.testingStatus === "hands-on-tested"
                  ? product.testingNotes
                  : "Research-based assessment; we have not tested this product firsthand."}
              </p>
            </div>
          </details>
        </article>
      ))}
    </div>
    </>))}
  </section>
)}

<script>
  import {
    AFFILIATE_CLICK_ENDPOINT,
    ANALYTICS_SESSION_KEY,
    createAffiliateClickTracker,
  } from "../scripts/affiliate-click-tracker.js";
  import {
    AFFILIATE_CLICK_EVENT_NAME,
    sendGoogleAnalyticsEvent,
  } from "../scripts/google-analytics.js";
  import { shouldTrackAnalytics } from "../scripts/analytics-preference.js";

  const analyticsSessionId = () => {
    try {
      const existing = sessionStorage.getItem(ANALYTICS_SESSION_KEY);
      if (existing) return existing;
      const created = crypto.randomUUID();
      sessionStorage.setItem(ANALYTICS_SESSION_KEY, created);
      return created;
    } catch {
      return "";
    }
  };

  const deviceType = () => {
    if (window.matchMedia("(max-width: 767px)").matches) return "mobile";
    if (window.matchMedia("(max-width: 1023px)").matches) return "tablet";
    return "desktop";
  };

  const sendAffiliateClick = (event: Record<string, string>) => {
    const payload = JSON.stringify(event);
    try {
      if (navigator.sendBeacon) {
        const accepted = navigator.sendBeacon(
          AFFILIATE_CLICK_ENDPOINT,
          new Blob([payload], { type: "application/json" }),
        );
        if (accepted) return;
      }
    } catch {
      // Best-effort analytics must never affect the retailer link.
    }

    fetch(AFFILIATE_CLICK_ENDPOINT, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: payload,
      credentials: "same-origin",
      keepalive: true,
    }).catch(() => {});
  };

  const recordAffiliateClick = (event: Record<string, string>) => {
    sendAffiliateClick(event);
    sendGoogleAnalyticsEvent(AFFILIATE_CLICK_EVENT_NAME, {
      affiliate_network: event.affiliateNetwork,
      guide_path: event.guidePath,
      item_id: event.productId,
      item_name: event.productName,
      link_domain: event.destinationHost,
      merchant: event.merchant,
    });
  };

  const affiliateClickTracker = createAffiliateClickTracker({
    recordEvent: recordAffiliateClick,
    pagePath: () => window.location.pathname,
    sessionId: analyticsSessionId,
    createEventId: () => crypto.randomUUID(),
    device: deviceType,
  });

  const recordAffiliateLink = (event: Event) => {
    if (!shouldTrackAnalytics()) return;
    if (!(event.target instanceof Element)) return;
    const link = event.target.closest('[data-commercial-link="affiliate"][data-affiliate-trackable="true"]');
    if (link instanceof HTMLAnchorElement) affiliateClickTracker.recordLink(link);
  };

  document.addEventListener("click", (event) => {
    if (event.button === 0) recordAffiliateLink(event);
  });
  document.addEventListener("auxclick", (event) => {
    if (event.button === 1) recordAffiliateLink(event);
  });

</script>
