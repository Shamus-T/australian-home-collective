---
import {
  getApprovedProductsForGuide,
  researchOutcomeLabels,
} from "../lib/commercial-products";
import {
  AFFILIATE_CLICK_ENDPOINT,
  ANALYTICS_SESSION_KEY,
} from "../scripts/affiliate-click-tracker.js";

interface Props {
  guidePath: string;
  title?: string;
  intro?: string;
  variant?: "solution" | "quick" | "comparison";
}

const {
  guidePath,
  title = "Products currently worth comparing",
  intro = "These options have been checked against the measurements and buying questions in this guide.",
  variant = "solution",
} = Astro.props;

const products = getApprovedProductsForGuide(guidePath);
const hasAffiliateLinks = products.some((product) => product.affiliate);
const sectionId = `commercial-products-${guidePath
  .replace(/^\/guides\//, "")
  .replace(/\/$/, "")}`;

const formatDate = (date: string) =>
  new Intl.DateTimeFormat("en-AU", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "Australia/Brisbane",
  }).format(new Date(`${date}T00:00:00+10:00`));
const retailerLabel = (product: (typeof products)[number]) =>
  product.linkLabel.startsWith("View at ")
    ? `Check current price at ${product.merchant} →`
    : product.linkLabel;
---

{products.length > 0 && (
  <section
    class={`commercial-product-block commercial-product-block--${variant}`}
    aria-labelledby={sectionId}
    data-commercial-product-block
    data-affiliate-endpoint={AFFILIATE_CLICK_ENDPOINT}
    data-analytics-session-key={ANALYTICS_SESSION_KEY}
  >
    <h2 id={sectionId}>{title}</h2>
    <p class="commercial-product-context" data-commercial-solution-context>{intro}</p>
    {hasAffiliateLinks && (
      <p class="commercial-product-disclosure" aria-label="Affiliate disclosure">
        Some links below are affiliate links. If you buy through one, we may earn a commission at
        no extra cost to you. <a href="/affiliate-disclosure/">Learn more.</a>
      </p>
    )}
    {variant === "comparison" && (
      <p class="table-hint">Swipe sideways to see the full comparison on a phone.</p>
    )}
    {variant === "comparison" && (
      <div class="commercial-product-comparison-wrap">
        <table class="commercial-product-comparison">
          <caption>Compare these researched options</caption>
          <thead><tr><th scope="col">Model</th><th scope="col">May suit</th><th scope="col">Check first</th><th scope="col">Retailer</th></tr></thead>
          <tbody>
            {products.map((product) => (
              <tr>
                <th scope="row">{product.name}</th>
                <td>{product.suitability.suits[0]}</td>
                <td>{product.drawbacks[0]}</td>
                <td>
                  <a
                    href={product.destinationUrl}
                    target="_blank"
                    rel="sponsored nofollow noopener noreferrer"
                    data-commercial-link={product.affiliate ? "affiliate" : "retailer"}
                    data-commercial-product-id={product.id}
                    data-commercial-product-name={product.name}
                    data-commercial-guide-path={guidePath}
                    data-commercial-affiliate-network={product.affiliateNetwork ?? undefined}
                    data-commercial-merchant={product.merchant}
                    data-commercial-destination-host={new URL(product.destinationUrl).hostname}
                    data-affiliate-trackable={product.affiliate ? "true" : undefined}
                  >{retailerLabel(product)}</a>
                  {product.affiliate && <small class="commercial-product-table-disclosure">We may earn a commission if you buy through this link.</small>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
    {variant === "comparison" && <h3 class="commercial-product-details-heading">More about each option</h3>}
    <div class="commercial-product-grid">
      {products.map((product) => (
        <article class="commercial-product-card" data-commercial-product-card>
          <p class="commercial-product-type">{product.productType}</p>
          <h3>{product.name}</h3>
          <p>{product.summary}</p>
          {variant !== "comparison" && <div class="commercial-product-fit">
            <p><strong>Good fit for</strong><br />{product.suitability.suits[0]}</p>
            <p><strong>Check before buying</strong><br />{product.drawbacks[0]}</p>
          </div>}
          {variant !== "quick" && <p class="commercial-product-outcome">{researchOutcomeLabels[product.researchOutcome!]}</p>}
          <details class="commercial-product-disclosure-details">
            <summary class="commercial-product-details-toggle">More suitability and drawbacks</summary>
            <div
              class="commercial-product-details-content"
              id={`commercial-product-details-${product.id}`}
              aria-label={`${product.name} suitability and drawbacks`}
            >
              <p><strong>May suit:</strong> {product.suitability.suits.join("; ")}.</p>
              <p><strong>May not suit:</strong> {product.suitability.mayNotSuit.join("; ")}.</p>
              <div class="commercial-product-drawbacks">
                <p><strong>Drawbacks to consider:</strong></p>
                <ul>
                  {product.drawbacks.map((drawback) => <li>{drawback}</li>)}
                </ul>
              </div>
              <p class="commercial-product-reviewed">
                Evidence confidence: {product.evidenceConfidence}. Last reviewed{" "}
                {formatDate(product.lastReviewedOn!)}.{" "}
                {product.testingStatus === "hands-on-tested"
                  ? product.testingNotes
                  : "Research-based assessment; we have not tested this product firsthand."}
              </p>
            </div>
          </details>
          {variant !== "comparison" && <a
            href={product.destinationUrl}
            target="_blank"
            rel="sponsored nofollow noopener noreferrer"
            data-commercial-link={product.affiliate ? "affiliate" : "retailer"}
            data-commercial-product-id={product.id}
            data-commercial-product-name={product.name}
            data-commercial-guide-path={guidePath}
            data-commercial-affiliate-network={product.affiliateNetwork ?? undefined}
            data-commercial-merchant={product.merchant}
            data-commercial-destination-host={new URL(product.destinationUrl).hostname}
            data-affiliate-trackable={product.affiliate ? "true" : undefined}
          >
            {retailerLabel(product)}
          </a>}
          {product.affiliate && variant !== "comparison" && (
            <p class="commercial-product-link-disclosure">
              We may earn a commission if you buy through this link, at no extra cost to you.
            </p>
          )}
        </article>
      ))}
    </div>
  </section>
)}

<script>
  import {
    AFFILIATE_CLICK_ENDPOINT,
    ANALYTICS_SESSION_KEY,
    createAffiliateClickTracker,
  } from "../scripts/affiliate-click-tracker.js";
  import {
    AFFILIATE_CLICK_EVENT_NAME,
    sendGoogleAnalyticsEvent,
  } from "../scripts/google-analytics.js";

  const analyticsSessionId = () => {
    try {
      const existing = sessionStorage.getItem(ANALYTICS_SESSION_KEY);
      if (existing) return existing;
      const created = crypto.randomUUID();
      sessionStorage.setItem(ANALYTICS_SESSION_KEY, created);
      return created;
    } catch {
      return "";
    }
  };

  const deviceType = () => {
    if (window.matchMedia("(max-width: 767px)").matches) return "mobile";
    if (window.matchMedia("(max-width: 1023px)").matches) return "tablet";
    return "desktop";
  };

  const sendAffiliateClick = (event: Record<string, string>) => {
    const payload = JSON.stringify(event);
    try {
      if (navigator.sendBeacon) {
        const accepted = navigator.sendBeacon(
          AFFILIATE_CLICK_ENDPOINT,
          new Blob([payload], { type: "application/json" }),
        );
        if (accepted) return;
      }
    } catch {
      // Best-effort analytics must never affect the retailer link.
    }

    fetch(AFFILIATE_CLICK_ENDPOINT, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: payload,
      credentials: "same-origin",
      keepalive: true,
    }).catch(() => {});
  };

  const recordAffiliateClick = (event: Record<string, string>) => {
    sendAffiliateClick(event);
    sendGoogleAnalyticsEvent(AFFILIATE_CLICK_EVENT_NAME, {
      affiliate_network: event.affiliateNetwork,
      guide_path: event.guidePath,
      item_id: event.productId,
      item_name: event.productName,
      link_domain: event.destinationHost,
      merchant: event.merchant,
    });
  };

  const affiliateClickTracker = createAffiliateClickTracker({
    recordEvent: recordAffiliateClick,
    pagePath: () => window.location.pathname,
    sessionId: analyticsSessionId,
    createEventId: () => crypto.randomUUID(),
    device: deviceType,
  });

  const recordAffiliateLink = (event: Event) => {
    if (!(event.target instanceof Element)) return;
    const link = event.target.closest('[data-commercial-link="affiliate"][data-affiliate-trackable="true"]');
    if (link instanceof HTMLAnchorElement) affiliateClickTracker.recordLink(link);
  };

  document.addEventListener("click", (event) => {
    if (event.button === 0) recordAffiliateLink(event);
  });
  document.addEventListener("auxclick", (event) => {
    if (event.button === 1) recordAffiliateLink(event);
  });

</script>
