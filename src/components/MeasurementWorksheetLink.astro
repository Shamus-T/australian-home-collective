---
interface Props {
  appliance: "washing-machine" | "dishwasher" | "fridge";
}
const { appliance } = Astro.props;
const name = appliance === "washing-machine" ? "washing machine" : appliance;
---

<aside class="worksheet-shortcut" aria-label="Free measuring worksheet">
  <p><strong>Free {name} measuring worksheet</strong><span>Print one A4 page and take your measurements with you.</span></p>
  <a href={`/downloads/${appliance}-measurement-worksheet.pdf`} download data-measurement-download={appliance} data-download-location="intro">Download worksheet (PDF)</a>
</aside>

<style>
  .worksheet-shortcut { display: flex; flex-wrap: wrap; align-items: center; gap: 0.85rem 1.4rem; margin: 1.5rem 0 2rem; padding: 1rem 1.2rem; border-left: 4px solid #245b63; background: #f0f5f2; }
  .worksheet-shortcut p { flex: 1 1 18rem; margin: 0; font-size: 0.95rem; line-height: 1.6; }
  .worksheet-shortcut strong, .worksheet-shortcut span { display: block; }
  .worksheet-shortcut a { font-weight: 700; line-height: 1.5; text-underline-offset: 0.2em; }
  @media print { .worksheet-shortcut { display: none; } }
</style>
