---
interface Props { title: string; links: { href: string; label: string; detail: string }[]; }
const { title, links } = Astro.props;
---
<nav class="buying-journey-nav" aria-label={title}>
  <p><strong>{title}</strong></p>
  <ul>{links.map(link => <li><a href={link.href}><strong>{link.label}</strong><span>{link.detail}</span></a></li>)}</ul>
</nav>
<style>
  .buying-journey-nav { margin: 24px 0; }
  .buying-journey-nav ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; list-style: none; padding: 0; margin: 12px 0; }
  .buying-journey-nav li { margin: 0; }
  .buying-journey-nav a { display: flex; flex-direction: column; justify-content: center; height: 100%; box-sizing: border-box; padding: 12px; border: 1px solid var(--line); border-radius: 8px; background: #f2f4ed; text-decoration: none; }
  .buying-journey-nav a:hover, .buying-journey-nav a:focus-visible { outline: 2px solid var(--green-dark); outline-offset: 2px; }
  .buying-journey-nav span { display: block; font-size: .875rem; line-height: 1.45; margin-top: 4px; }
</style>
