---
import { goodGuysArtworkDataUrl } from "../lib/retailer-artwork";
import branding from "../data/retailer-branding.json";
import type { CommercialProduct, CommercialRetailerOffer } from "../types/commercial-product";

interface Props {
  product: CommercialProduct;
  offers: CommercialRetailerOffer[];
  placement: "card" | "comparison" | "stack";
}

const { product, offers, placement } = Astro.props;
const disclosureId = `retailer-disclosure-${placement}-${product.id}`;
const showDisclosure = placement === "card" && offers.some((offer) => offer.affiliate);
const isGoodGuys = (offer: CommercialRetailerOffer) =>
  offer.merchant === "The Good Guys" && offer.affiliateNetwork === "partnerize";
const partnerLogos: Record<string, string> = {
  Kurgo: branding.kurgo.src,
  "Eiderdown Australia": branding.eiderdown.src,
  "De'Longhi": branding.delonghi.src,
  Kenwood: branding.kenwood.src,
  PetSafe: branding.petsafe.src,
};
---

<div class={`commercial-retailers commercial-retailers--${placement}`} aria-label={`${product.name} retailers`}>
  {placement === "card" && <p class="commercial-retailers-label">Check today’s price and postcode delivery:</p>}
  <ul class="commercial-retailer-links" role="list">
    {offers.map((offer) => (
      <li>
        <a
          class:list={[
            "commercial-retailer-link",
            { "commercial-retailer-link--amazon": offer.affiliateNetwork === "amazon-australia" },
            { "commercial-retailer-link--good-guys": isGoodGuys(offer) },
            { "commercial-retailer-link--partner-logo": offer.affiliateNetwork === "commission-factory" && partnerLogos[offer.merchant] },
            { "commercial-retailer-link--beds-n-dreams": offer.merchant === "Beds n Dreams" && offer.affiliateNetwork === "partnerize" },
          ]}
          href={offer.destinationUrl}
          target="_blank"
          rel="sponsored nofollow noopener noreferrer"
          aria-label={`Check current price and availability of ${product.name} at ${offer.merchant}`}
          aria-describedby={showDisclosure ? disclosureId : undefined}
          data-commercial-link={offer.affiliate ? "affiliate" : "retailer"}
          data-commercial-placement={placement}
          data-commercial-product-id={product.id}
          data-commercial-product-name={product.name}
          data-commercial-guide-path={product.guidePath}
          data-commercial-affiliate-network={offer.affiliateNetwork ?? undefined}
          data-commercial-merchant={offer.merchant}
          data-commercial-destination-host={new URL(offer.destinationUrl).hostname}
          data-affiliate-trackable={offer.affiliate ? "true" : undefined}
        >
          {isGoodGuys(offer) ? (
            <svg class="commercial-retailer-artwork" data-retailer-artwork="good-guys" viewBox="0 0 868 185" width="212" height="45.2" aria-hidden="true" focusable="false">
              <image href={goodGuysArtworkDataUrl} width="868" height="185" />
            </svg>
          ) : offer.affiliateNetwork === "amazon-australia" ? (
            <img class="commercial-retailer-badge" src="/images/retailers/amazon-available-official.png" alt="Available at Amazon" width="1500" height="242" loading="eager" />
          ) : offer.merchant === "Beds n Dreams" && offer.affiliateNetwork === "partnerize" ? (
            <><img class="commercial-retailer-badge" src="/images/retailers/beds-n-dreams-partnerize.png" alt="Beds n Dreams" width="1504" height="1091" loading="eager" /><span class="commercial-retailer-action">Check price</span></>
          ) : offer.affiliateNetwork === "commission-factory" && offer.merchant === "Eiderdown Australia" ? (
            <img class="commercial-retailer-badge" src={branding.eiderdown.src} style="width: 180px; height: auto; max-height: 48px;" alt="Eiderdown Australia" width={branding.eiderdown.width} height={branding.eiderdown.height} />
          ) : offer.affiliateNetwork === "commission-factory" && partnerLogos[offer.merchant] ? (
            <><img class="commercial-retailer-badge" src={partnerLogos[offer.merchant]} alt="" width="48" height="48" /><span class="commercial-retailer-action">{offer.merchant}</span></>
          ) : (
            <span class="commercial-retailer-name">Check price at {offer.merchant}</span>
          )}
        </a>
      </li>
    ))}
  </ul>
  {showDisclosure && (
    <p class="commercial-retailer-disclosure" id={disclosureId}>
      We may earn commission through these links.{offers.length > 1 && " Higher-paying partners appear first."}
    </p>
  )}
</div>
