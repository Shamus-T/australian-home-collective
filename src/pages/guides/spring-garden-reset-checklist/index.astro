<ArticleLayout
  title="Spring Garden Reset Checklist for Australian Homes"
  seoTitle="Spring Garden Reset Checklist for Australian Homes"
  description="Inspect plants, soil, mulch, pots, irrigation, weeds and tools, then set practical Australian garden priorities before hotter weather arrives."
  category="Outdoor & Garden"
