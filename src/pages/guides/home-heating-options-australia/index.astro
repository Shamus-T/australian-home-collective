          </tr>
          <tr>
            <td>Oil column heater</td>
            <td>Bedrooms and quiet enclosed rooms</td>
            <td>Silent, steady warmth</td>
            <td>Slow initial warm-up</td>
          </tr>
          <tr>
            <td>Panel heater</td>
            <td>Background heating in enclosed rooms</td>
            <td>Slim and quiet</td>
            <td>May struggle in large or draughty spaces</td>
          </tr>
          <tr>
            <td>Radiant heater</td>
            <td>Warming people or a defined spot</td>
