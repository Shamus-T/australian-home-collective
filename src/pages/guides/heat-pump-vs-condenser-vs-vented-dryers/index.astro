---
import CommercialProductBlock from "../../../components/CommercialProductBlock.astro";
import ArticleLayout from "../../../layouts/ArticleLayout.astro";
import RelatedGuidesBlock from "../../../components/RelatedGuidesBlock.astro";
import applianceComparisons from "../../../data/appliance-buying-comparisons.json";
import dryerEnergy from "../../../data/dryer-running-cost-comparison.json";

const { vented, heatPump, tariffAudPerKwh: tariff, labelLoadsPerYear } = dryerEnergy;
const rrpPremium = heatPump.publishedRrpAud - vented.publishedRrpAud;
const labelSaving = vented.annualKwh - heatPump.annualKwh;
const money = (amount: number) => new Intl.NumberFormat('en-AU', { style: 'currency', currency: 'AUD' }).format(amount);
const annualExamples = dryerEnergy.loadsPerWeek.map(loads => ({
  loads,
  ventedCost: vented.annualKwh * loads * tariff,
  heatPumpCost: heatPump.annualKwh * loads * tariff,
  saving: labelSaving * loads * tariff,
  payback: rrpPremium / (labelSaving * loads * tariff),
}));

const relatedGuides = [
  {
    href: "/categories/laundry/",
    title: "Laundry",
    description: "More laundry guides covering appliance fit, drying space, storage and everyday routines.",
  },
  {
    href: "/guides/washing-machine-and-dryer-space-what-to-measure-before-buying-storage/",
    title: "Laundry Dimensions Australia",
    description: "Measure the washer, dryer, opening zones, hoses and service access before planning the room.",
  },
  {
    href: "/guides/laundry-drying-space-what-to-measure-before-buying-airers-or-racks/",
    title: "Drying Space That Works in Real Weather",
    description: "Plan indoor and outdoor air drying capacity around the household routine and available space.",
  },
  {
    href: "/guides/lower-waste-laundry-essentials/",
    title: "A Lower Waste Laundry Routine",
    description: "Reduce unnecessary products, energy and replacement purchases without complicating laundry day.",
  },
];

const faqs = [
  {
    question: "Is a heat pump dryer better than a vented dryer?",
    answer: "A heat pump dryer usually uses much less electricity and does not send moist exhaust air into the room, but it costs more to buy and cycles commonly take longer. A vented dryer can be cheaper and faster, particularly for occasional use, when it can be correctly ducted or the room has suitable ventilation.",
  },
  {
    question: "What is the difference between a condenser and heat pump dryer?",
    answer: "Both condense moisture into a tank or drain. A conventional condenser dryer uses an electric heating element and expels more heat, while a heat pump model recirculates warm air through a refrigeration system. The heat pump type is generally more efficient but takes longer and costs more upfront.",
  },
  {
    question: "Can a heat pump dryer be wall mounted?",
    answer: "Usually not. Heat pump and conventional condenser dryers are commonly floor standing machines. Some lighter vented dryers can be wall mounted using the brackets and orientation specified by the manufacturer. Never improvise a wall mounting or stacking arrangement.",
  },
];
---

<ArticleLayout
  title="Heat Pump vs Condenser vs Vented Dryers"
  seoTitle="Heat Pump vs Condenser vs Vented Dryers: Costs & Fit"
  description="Choose a dryer for your Australian laundry. Compare heat pump, condenser and vented types, energy costs, venting, capacity and two researched models."
  category="Laundry"
  date="Updated October 2026"
  datePublished="2026-07-23"
  dateModified="2026-10-13"
  readingTime="8 minute read"
  faqs={faqs}
  showAffiliateDisclosure={false}
  image="/images/guides/dryer-types-australia.webp"
  imageAlt="A front loading washer and dryer side by side in a practical Australian laundry with towels and clear floor space"
>
  <p>
    A dryer type changes more than the electricity bill. It affects room ventilation, cycle time,
    purchase price, installation options and the amount of heat released into the laundry.
  </p>
  <p>
    Heat pump dryers usually use much less electricity, but they are not the only sensible choice.
    The better fit depends on how often the dryer runs, whether moist air can be
    ducted outside, how quickly loads need to finish and what the household can spend upfront.
  </p>

  <section aria-labelledby="dryer-choice-heading">
    <h2 id="dryer-choice-heading">Which dryer type should you shortlist?</h2>
    <ul class="feature-list">
      <li><strong>Frequent loads, no exhaust duct:</strong> start with heat pump if you can afford the higher purchase price and allow longer cycles.</li>
      <li><strong>Occasional loads, a smaller budget:</strong> consider vented if the room and exhaust arrangement meet the manual. Some models also permit wall mounting.</li>
      <li><strong>No vent path, heat pump beyond budget:</strong> compare conventional condenser, allowing for room heat and higher electricity use. We have not yet assessed an exact model for this guide.</li>
    </ul>
    <p>First rule out anything that cannot handle your usual load or fit safely. Then compare the total installed price and the cost of the drying you actually do.</p>
  </section>
  <nav aria-label="Dryer buying guide sections">
    <ul>
      <li><a href="#dryer-comparison-heading">Compare all three dryer types</a></li>
      <li><a href="#commercial-products-heat-pump-vs-condenser-vs-vented-dryers">Compare two researched dryers</a></li>
      <li><a href="#dryer-running-cost-heading">Work out running costs</a></li>
      <li><a href="#dryer-order-heading">Check installation and delivered cost</a></li>
    </ul>
  </nav>

  <section aria-labelledby="dryer-comparison-heading">
    <h2 id="dryer-comparison-heading">Dryer types compared</h2>
    <p class="table-hint">Swipe sideways to compare the full table.</p>
    <div class="comparison-wrap">
      <table class="comparison-table">
        <caption>Heat pump, condenser and vented dryer differences</caption>
        <thead>
          <tr>
            <th scope="col">Type</th>
            <th scope="col">How moisture leaves the load</th>
            <th scope="col">Main strengths</th>
            <th scope="col">Main trade offs</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Heat pump</td>
            <td>Condenses water into a tank or drain and recirculates warm air</td>
            <td>Low energy use, lower drying temperatures, no moist exhaust into the room</td>
            <td>Higher purchase price, longer cycles, more filters and a condenser area to maintain</td>
          </tr>
          <tr>
            <td>Conventional condenser</td>
            <td>Condenses water into a tank or drain using electric resistance heat</td>
            <td>No external duct, familiar cycle behaviour, often cheaper than a heat pump model</td>
            <td>Higher energy use and more heat released into the room</td>
          </tr>
          <tr>
            <td>Vented</td>
            <td>Pushes warm moist air through a front or rear vent</td>
            <td>Lower purchase price, simple construction, faster cycles on many models, some wall mounting options</td>
            <td>Needs effective room ventilation or suitable ducting, generally higher energy use</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <CommercialProductBlock guidePath="/guides/heat-pump-vs-condenser-vs-vented-dryers/" title="Two dryers for different laundry routines" intro="Before you compare prices, check capacity, installed depth and ventilation. The 9kg Bosch heat pump suits larger, regular loads; consider the 6kg Electrolux vented model for smaller, occasional loads with suitable exhaust. They are different capacities, not a like-for-like efficiency contest. Both assessments use documents and owner feedback, not firsthand AHC testing." variant="comparison" comparisonDetails={applianceComparisons} />

  <h2 id="dryer-running-cost-heading">Heat pump versus vented: what do the running costs look like?</h2>
  <p>
    The energy difference can be substantial. Electrolux publishes {vented.annualKwh}kWh/year for its {vented.capacityKg}kg {vented.model} vented dryer and {heatPump.annualKwh}kWh/year for its {heatPump.capacityKg}kg {heatPump.model} heat pump dryer. That is <strong>about {Math.round(labelSaving / vented.annualKwh * 100)}% less
    energy on the published figures</strong>, despite the heat pump model's larger rated capacity.
    Heat pump technology recovers and reuses heat rather than exhausting heated air after use.
  </p>
  <p>
    The Australian Government's <a href={dryerEnergy.labelBasisUrl} target="_blank" rel="noopener noreferrer">Energy Rating Label guide</a>{" "}
    explains that dryer annual consumption assumes one full load per week. The comparison below
    uses those published figures and an <strong>assumed electricity usage rate of 30c/kWh</strong>.
    It compares each model at its own rated load: 7kg versus 8kg. It is not an equal-load laboratory
    test or a measurement made by AHC.
  </p>
  <p class="table-hint">Swipe sideways to compare the full table.</p>
  <div class="comparison-wrap" role="region" aria-label="Electrolux dryer RRP and energy comparison" tabindex="0">
    <table class="comparison-table">
      <caption>Electrolux EDV705H3WC versus EDH803P5WC: published specifications and calculated costs</caption>
      <thead><tr><th scope="col">Measure</th><th scope="col">EDV705H3WC vented</th><th scope="col">EDH803P5WC heat pump</th></tr></thead>
      <tbody>
        <tr><th scope="row">Rated capacity</th><td>{vented.capacityKg}kg</td><td>{heatPump.capacityKg}kg</td></tr>
        <tr><th scope="row">Published RRP reference</th><td>{money(vented.publishedRrpAud)}</td><td>{money(heatPump.publishedRrpAud)}</td></tr>
        <tr><th scope="row">Energy rating</th><td>{vented.stars} stars</td><td>{heatPump.stars} stars</td></tr>
        <tr><th scope="row">Annual label energy, one full load/week</th><td>{vented.annualKwh}kWh</td><td>{heatPump.annualKwh}kWh</td></tr>
        <tr><th scope="row">Calculated energy per full rated load</th><td>About {(vented.annualKwh / labelLoadsPerYear).toFixed(2)}kWh</td><td>About {(heatPump.annualKwh / labelLoadsPerYear).toFixed(2)}kWh</td></tr>
        <tr><th scope="row">Calculated electricity cost per full rated load, 30c/kWh</th><td>{money(vented.annualKwh / labelLoadsPerYear * tariff)}</td><td>{money(heatPump.annualKwh / labelLoadsPerYear * tariff)}</td></tr>
      </tbody>
    </table>
  </div>
  <p>
    <strong>Price basis:</strong> {money(vented.publishedRrpAud)} and {money(heatPump.publishedRrpAud)} are the Australian RRPs
    printed in Electrolux's retailer-hosted fact sheets, a {money(rrpPremium)} difference. They are
    reference prices, not current offers. Electrolux's current downloadable sheets omit prices;
    retailer discounts, delivery and installation can change the amount you actually pay.
    Sources checked 13 October 2026.
  </p>

  <section aria-labelledby="dryer-payback-heading">
    <h3 id="dryer-payback-heading">How quickly could the $700 RRP difference be recovered?</h3>
    <p>
      At 30c/kWh, the label figures imply roughly <strong>{money(labelSaving / labelLoadsPerYear * tariff)} less electricity
      per full rated-load cycle</strong> for the heat pump. More frequent drying makes that saving
      accumulate faster. These scenarios assume the same number of full cycles for each machine
      throughout a 52-week year, at their different rated capacities.
    </p>
    <p class="table-hint">Swipe sideways to compare the full table.</p>
    <div class="comparison-wrap" role="region" aria-label="Dryer annual electricity cost and RRP payback scenarios" tabindex="0">
      <table class="comparison-table">
        <caption>Label-based estimates at 30c/kWh; electricity savings recover the $700 RRP premium</caption>
        <thead><tr><th scope="col">Full cycles per week</th><th scope="col">Vented electricity/year</th><th scope="col">Heat pump electricity/year</th><th scope="col">Saving/year</th><th scope="col">Simple RRP payback</th></tr></thead>
        <tbody>{annualExamples.map(example => <tr>
          <th scope="row">{example.loads}</th>
          <td>{money(example.ventedCost)}</td><td>{money(example.heatPumpCost)}</td>
          <td>{money(example.saving)}</td><td>About {example.payback.toFixed(1)} years</td>
        </tr>)}</tbody>
      </table>
    </div>
    <p>
      <strong>For regular drying, the running-cost advantage is meaningful:</strong> at five full cycles
      a week, this calculation saves {money(labelSaving * 5 * tariff)} a year and recovers the RRP premium in about {(rrpPremium / (labelSaving * 5 * tariff)).toFixed(1)} years. For occasional use, one full cycle a week saves {money(labelSaving * tariff)} a year, so electricity savings alone take much longer to cover that premium.
      At 40c/kWh, three full cycles a week would save {money(labelSaving * 3 * 0.40)} a year, shortening the same
      RRP payback to about {(rrpPremium / (labelSaving * 3 * 0.40)).toFixed(1)} years.
    </p>
    <p>
      Use the electricity usage tariff on your bill, excluding the daily supply charge. For this
      label-based estimate, annual saving is <strong>185kWh × full cycles per week × tariff</strong>;
      divide the difference in your actual delivered and installed prices by that saving to estimate
      your own payback. Discounts can change the result substantially.
    </p>
    <p>
      Actual consumption varies with the load, program, incoming moisture, room conditions and
      maintenance. Smaller loads cannot be assumed to use a fixed fraction of the full-load energy.
      These estimates exclude repairs, finance costs, future tariffs and differences in appliance
      lifespan; a calculated payback is not a lifespan promise. The heat pump also offers more rated
      capacity and lower-temperature drying, but allow for cycle time, floor space and installation.
    </p>
    <p class="source-note">
      Energy and capacity: <a href={vented.specificationUrl} target="_blank" rel="noopener noreferrer">Electrolux EDV705H3WC specifications</a>{" "}
      and <a href={heatPump.specificationUrl} target="_blank" rel="noopener noreferrer">EDH803P5WC specifications</a>.
      RRP evidence: Electrolux's <a href={vented.rrpSourceUrl} target="_blank" rel="noopener noreferrer">EDV705H3WC fact sheet (PDF)</a>{" "}
      and <a href={heatPump.rrpSourceUrl} target="_blank" rel="noopener noreferrer">EDH803P5WC fact sheet (PDF)</a>, hosted by Bing Lee.
      These are source documents, not shopping links.
    </p>
  </section>

  <section aria-labelledby="dryer-order-heading">
    <h2 id="dryer-order-heading">Check the whole installation before the price</h2>
    <ul class="feature-list">
      <li><strong>Bosch WQG24201AU:</strong> allow 648mm closed-door depth and 1,096mm with the door open, plus access and the manual's clearances. It needs filter and heat-exchanger care; it is not a self-cleaning-condenser model.</li>
      <li><strong>Electrolux EDV605H3WC:</strong> the published body is 600mm wide × 795mm high × 560mm deep. Do not use body depth as the complete installed depth. Its series manual includes larger overall dimensions and door-opening drawings; confirm the exact installation with the retailer.</li>
      <li><strong>For the Electrolux vent:</strong> a cupboard or small unvented laundry requires a venting kit. The manual specifies a maximum 2m exhaust duct at 100mm diameter, with clear inlet airflow. Check the duct route before buying.</li>
      <li><strong>If wall mounting:</strong> Electrolux supplies a mounting kit, but suitable wall construction, fitting and the illustrated clearances still need checking. Neither model may be placed on a washer without an approved combination and kit.</li>
    </ul>
    <p>Compare the exact model's current price plus delivery, old-appliance removal, any vent or stacking kit and installation. Enter your postcode to confirm stock and delivery dates.</p>
    <p>Installation sources: <a href="https://media3.bsh-group.com/Documents/9001730323_C.pdf" target="_blank" rel="noopener noreferrer">Bosch instructions</a>; <a href="https://www.electrolux.com.au/laundry/dryers/edv605h3wc/" target="_blank" rel="noopener noreferrer">Electrolux specifications</a> and <a href="https://www.electrolux.com.au/documenthandler.ashx?file=aHR0cHM6Ly9yZXNvdXJjZS5lbGVjdHJvbHV4LmNvbS5hdS9QdWJsaWMvRmlsZS8_SWQ9NjcyMTg1&amp;lang=#page=8" target="_blank" rel="noopener noreferrer">its installation manual, pages 8–10</a>. Electrolux documents and Australian listing checked 12 October 2026; Bosch assessment checked 11 October.</p>
  </section>

  <h2>Room ventilation is still relevant for every type</h2>
  <p>
    A heat pump dryer does not require an exhaust duct, but it still needs the room conditions and
    clearances stated in its manual. Some models specify a permitted operating temperature range.
    A very small closed cupboard can become too warm during use.
  </p>
  <p>
    A conventional condenser collects the water rather than exhausting steam, but it releases more
    heat than a heat pump model. A vented dryer has the most direct moisture concern. If it cannot
    be ducted outside, the laundry needs enough ventilation to prevent persistent condensation and
    damp surfaces.
  </p>

  <h2>Measure the installed depth and open door</h2>
  <p>
    Dryer listings do not always describe depth in the same way. A body measurement may exclude
    the closed door, handle or the much larger space needed with the door open. Record every
    relevant figure, then add the manufacturer's required space for connections and airflow.
  </p>
  <p>
    Keep the door swing clear of baskets and the room door. Filters, condenser access panels and
    water tanks also need to be removed without dismantling nearby storage. The full measurement
    sequence is covered in the <a href="/guides/washing-machine-and-dryer-space-what-to-measure-before-buying-storage/">Laundry Dimensions Australia guide</a>.
  </p>

  <h2 id="stacking-requirements">Check the stacking requirements for your exact models</h2>
  <p>
    A dryer being described as stackable does not mean it can sit on any front loader. Check both
    appliances' installation instructions for a compatible pairing and the required stacking
    arrangement. The washer sits below the dryer, and the completed controls and filters must
    remain within safe reach.
  </p>
  <p>
    Appliance mats designed for use between stacked appliances can provide grip, reduce noise
    and protect surfaces. They do not establish that any two appliances can be stacked together.
    Where the manufacturer requires a particular stacking kit, a mat does not replace it.
  </p>
  <p>
    For example, the <a href="https://media3.bsh-group.com/Documents/9001730323_C.pdf#page=5" target="_blank" rel="noopener noreferrer">Bosch WQG24201AU installation instructions</a>{" "}
    require the dryer manufacturer's connection kit and prohibit other stacking methods.
    For this model, a mat alone is not an alternative to the specified kit. Check your own
    models' instructions rather than treating every mat or stacking kit as interchangeable.
  </p>

  <h2>Choose capacity around the washer and routine</h2>
  <p>
    Matching the dryer to the washer avoids splitting every load, but not all washed items go into
    the dryer. A household that line dries sheets and only machine dries towels may need less dryer
    capacity than the washer capacity suggests.
  </p>
  <p>
    Check the rated load for each program. Delicate, wool, bedding and quick cycles commonly accept
    less than the headline capacity. The largest number on the front panel does not apply to every
    fabric and setting.
  </p>

  <h2>Maintenance is part of the buying decision</h2>
  <ul class="feature-list">
    <li>Clean the lint filter at the frequency stated in the manual.</li>
    <li>Empty the water tank when the drain hose is not connected.</li>
    <li>Check whether the condenser is user cleaned or self cleaning.</li>
    <li>Keep vents, grilles and surrounding clearances open.</li>
    <li>Use the specified program and load for delicate items.</li>
    <li>Allow access for servicing without removing permanent cabinetry.</li>
  </ul>

  <RelatedGuidesBlock guides={relatedGuides} />
</ArticleLayout>

<style>
  :global(html) { scroll-padding-top: 14rem; }
  @media (min-width: 901px) { :global(html) { scroll-padding-top: 8rem; } }
</style>
