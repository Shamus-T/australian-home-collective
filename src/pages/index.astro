---
import BaseLayout from "../layouts/BaseLayout.astro";
import GuideCard from "../components/GuideCard.astro";
import {
  seasonalSections,
  type PublishedSeasonalGuide,
} from "../data/seasonalGuides";

const categories = [
  {
    href: "/categories/kitchen/",
    title: "Kitchen",
    description: "Bench space, pantry choices, dinner prep, cleaning and tools that earn their place.",
    image: "/images/kitchen.webp",
    imageAlt: "A warm kitchen with timber cabinetry, green accents and a tidy benchtop.",
  },
  {
    href: "/categories/laundry/",
    title: "Laundry",
    description: "Washing flow, drying space, hampers, cleaning supplies and the awkward corners of a small laundry.",
    image: "/images/laundry.webp",
    imageAlt: "A practical laundry room with warm finishes and tidy storage.",
  },
  {
    href: "/categories/bedroom/",
    title: "Bedroom",
    description: "Comfort, bedding, wardrobes, bedside habits and making a smaller bedroom work.",
    image: "/images/bedroom.webp",
    imageAlt: "A calm bedroom with soft bedding, warm light and practical storage.",
  },
  {
    href: "/categories/bathroom/",
    title: "Bathroom",
    description: "Vanity drawers, towel space, shower routines and cleaning access for busy bathrooms.",
    image: "/images/bathroom.webp",
    imageAlt: "A tidy bathroom with warm finishes, practical storage and soft natural light.",
  },
  {
    href: "/categories/pets/",
    title: "Pets",
    description: "Feeding, bedding, cleaning, travel and the way pets actually live in the home.",
    image: "/images/guides/pet-essentials-home-zones.webp",
    imageAlt: "A dog resting in a practical pet zone with bedding, a lead, grooming supplies and clear household access",
  },
  {
    href: "/categories/nursery-kids/",
    title: "Nursery & Kids",
    description: "Baby essentials, sleep, bath time, outings, growth and what can wait.",
    image: "/images/Nursery-kids.webp",
    imageAlt: "A tidy nursery room with timber furniture, soft lighting and practical baby storage.",
  },
  {
    href: "/categories/living-spaces/",
    title: "Living Spaces",
    description: "Seating, media, lighting, family clutter and shared rooms that are easier to put back together.",
    image: "/images/living-room.webp",
    imageAlt: "A warm living room with tidy storage, soft seating and natural light.",
  },
  {
    href: "/categories/home-office/",
    title: "Home Office",
    description: "Desk fit, lighting, calls, cables and workdays that fit the room.",
    image: "/images/home-office.webp",
    imageAlt: "A compact home office setup with a tidy desk, warm light and practical storage.",
  },
  {
    href: "/categories/garage-storage/",
    title: "Garage Storage Ideas",
    description: "Plan tools, tubs, shelves and wall storage while keeping the car, doors and walking routes clear.",
    image: "/images/garage.webp",
    imageAlt: "An organised garage with wall storage, shelves and clear floor space.",
  },
  {
    href: "/categories/outdoor-garden/",
    title: "Outdoor & Garden",
    description: "Weather, shade, plants, entertaining and keeping outdoor areas workable between uses.",
    image: "/images/outdoor-garden.webp",
    imageAlt: "A warm Australian patio garden with outdoor seating, greenery and practical storage.",
  },
];

function requireSeasonalGuide(
  seasonId: "spring" | "summer",
  href: string,
): PublishedSeasonalGuide {
  const section = seasonalSections.find((season) => season.id === seasonId);
  const guide = section?.guides.find((item) => item.status === "published" && item.href === href);

  if (!guide || guide.status !== "published") {
    throw new Error(`Missing published ${seasonId} guide: ${href}`);
  }

  return guide;
}

const springFeature = requireSeasonalGuide(
  "spring",
  "/guides/spring-home-maintenance-checklist/",
);

const springGuides = [
  requireSeasonalGuide("spring", "/guides/spring-cleaning-checklist/"),
  requireSeasonalGuide("spring", "/guides/20-minute-spring-reset/"),
  requireSeasonalGuide(
    "spring",
    "/guides/outdoor-entertaining-area-setup-what-to-plan-before-buying-extra-furniture-and-accessories/",
  ),
];

const featuredGuides = [
  {
    href: "/guides/gutter-maintenance-guide/",
    title: "Gutter Maintenance Guide",
    description: "Check what needs attention before spring rain or summer storms make a small problem harder to manage.",
    meta: "Maintenance",
  },
  {
    href: "/guides/lawn-care-basics/",
    title: "Lawn Care Basics",
    description: "Start with the lawn, local climate and maintenance needs before choosing equipment or treatments.",
    meta: "Outdoor & Garden",
  },
  {
    href: "/guides/garden-tool-care-and-seasonal-outdoor-reset/",
    title: "Garden Tool Care and Seasonal Outdoor Reset",
    description: "Sort, clean and store outdoor tools before buying replacements or adding more storage.",
    meta: "Outdoor & Garden",
  },
  {
    href: "/guides/outdoor-storage-ideas-australian-patios-balconies-gardens/",
    title: "Outdoor Storage Ideas for Australian Homes",
    description: "Plan weather exposure, access and what genuinely needs storing before choosing boxes or cabinets.",
    meta: "Outdoor & Garden",
  },
  {
    href: "/guides/cleaning-product-storage-what-to-check-before-buying-cabinets-or-caddies/",
    title: "Cleaning Product Storage",
    description: "Sort products, check child and pet access, and choose a safe storage zone before adding organisers.",
    meta: "Laundry",
  },
  {
    href: "/guides/best-kitchen-storage-ideas-small-australian-homes/",
    title: "Kitchen Storage Ideas for Small Australian Homes",
    description: "Reset bench, drawer and cupboard space around the way the kitchen is actually used.",
    meta: "Kitchen",
  },
];

const summerPlanningGuides = [
  requireSeasonalGuide("summer", "/guides/air-conditioning-buying-guide/"),
  requireSeasonalGuide("summer", "/guides/ceiling-fans-before-you-buy/"),
  requireSeasonalGuide(
    "summer",
    "/guides/outdoor-shade-setup-for-patios-and-backyards-what-to-check-before-buying/",
  ),
];
---

<BaseLayout
  title="Australian Home Collective"
  seoTitle="Australian Home Collective | Practical Home Guides"
  description="Practical Australian home guides for storage, room planning and smarter buying decisions—measure first, compare what matters and avoid costly mismatches."
>
  <section class="hero image-hero">
    <img
      class="hero-bg"
      src="/images/home-lifestyle-hero.jpg"
      alt="A warm Australian home interior with timber furniture, greenery, kitchen and living spaces"
      width="1800"
      height="1100"
      loading="eager"
      draggable="false"
    />
    <div class="container hero-content">
      <div class="hero-copy">
        <p class="eyebrow">For Australian homes</p>
        <h1>Practical home guides for better buying decisions</h1>
        <p class="lead">
          We look at how home products fit into real rooms and routines: what is worth
          measuring, what may be harder to clean than expected and what you can probably
          leave on the shelf.
        </p>
        <div class="hero-actions">
          <a class="button" href="/guides/">Browse Guides</a>
          <a class="button secondary" href="/categories/">Browse Categories</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section spring-section" data-homepage-seasonal-feature>
    <div class="container section-heading spring-heading">
      <div>
        <p class="eyebrow spring-season-label">Spring 2026</p>
        <h2>Spring at home</h2>
      </div>
      <p>
        Practical cleaning, maintenance and outdoor preparation for the warmer months ahead.
      </p>
    </div>

    <div class="container">
      <a class="spring-lead-card" href={springFeature.href} data-spring-primary-guide>
        <img
          data-seasonal-feature-image
          src={springFeature.image}
          alt={springFeature.imageAlt}
          width="1536"
          height="1024"
          loading="lazy"
          draggable="false"
          style={`object-position: ${springFeature.imagePosition ?? "center"};`}
        />
        <div class="spring-lead-copy">
          <p class="eyebrow">Featured spring guide</p>
          <h3>{springFeature.title}</h3>
          <p>{springFeature.description}</p>
          <p class="spring-download-note">Includes a free printable checklist.</p>
          <span class="text-link">
            Read the checklist
            <span aria-hidden="true">&rarr;</span>
          </span>
        </div>
      </a>
    </div>

    <div class="container grid three home-guide-grid spring-guide-grid">
      {springGuides.map((guide) => (
        <GuideCard
          href={guide.href}
          title={guide.title}
          description={guide.description}
          meta="Spring"
          image={guide.image}
          imageAlt={guide.imageAlt}
          imagePosition={guide.imagePosition}
          preferProvidedMetadata
        />
      ))}
    </div>

    <div class="container spring-all-guides">
      <a class="button secondary" href="/seasonal/#spring" data-spring-hub-link>
        Explore all spring guides
      </a>
    </div>
  </section>

  <section class="section home-promise" data-homepage-promise aria-label="The Australian Home Collective approach">
    <div class="container promise-grid">
      <article class="promise-item">
        <p class="eyebrow">Start with the home</p>
        <h2>Room and routine first</h2>
        <p>Begin with the space, the people using it and the job that needs solving.</p>
      </article>
      <article class="promise-item">
        <p class="eyebrow">Measure before buying</p>
        <h2>Check fit and upkeep</h2>
        <p>Access, cleaning, maintenance and everyday usability matter.</p>
      </article>
      <article class="promise-item">
        <p class="eyebrow">Buy only when it helps</p>
        <h2>Use what works</h2>
        <p>Sometimes the best answer is a better arrangement, not another product.</p>
      </article>
    </div>
  </section>

  <section class="section" data-homepage-category-grid>
    <div class="container section-heading">
      <div>
        <p class="eyebrow">Browse by category</p>
        <h2>Explore by area of the home</h2>
      </div>
      <p>Pick the room or household job that is bothering you now.</p>
    </div>
    <div class="container grid home-category-grid">
      {categories.map((category) => (
        <GuideCard
          href={category.href}
          title={category.title}
          description={category.description}
          meta="Category"
          image={category.image}
          imageAlt={category.imageAlt}
        />
      ))}
    </div>
  </section>

  <section class="section soft" data-featured-guides="homepage">
    <div class="container section-heading">
      <div>
        <p class="eyebrow">Seasonal priorities</p>
        <h2>Useful right now</h2>
      </div>
      <p>Small resets and maintenance jobs worth tackling while the weather is mild.</p>
    </div>
    <div class="container grid three home-guide-grid">
      {featuredGuides.map((guide) => (
        <GuideCard
          href={guide.href}
          title={guide.title}
          description={guide.description}
          meta={guide.meta}
        />
      ))}
    </div>
  </section>

  <section class="section summer-planning" data-homepage-summer-planning>
    <div class="container section-heading">
      <div>
        <p class="eyebrow">Plan ahead</p>
        <h2>Before summer arrives</h2>
      </div>
      <p>Research cooling, airflow and shade before the first heatwave makes the decision urgent.</p>
    </div>
    <div class="container grid three home-guide-grid">
      {summerPlanningGuides.map((guide) => (
        <GuideCard
          href={guide.href}
          title={guide.title}
          description={guide.description}
          meta="Summer planning"
          image={guide.image}
          imageAlt={guide.imageAlt}
          imagePosition={guide.imagePosition}
          preferProvidedMetadata
        />
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container grid two">
      <div>
        <p class="eyebrow">Our approach</p>
        <h2>How we choose what to cover</h2>
        <p>
          A topic earns its place when it helps with a real household decision. We look at
          room size, use, cleaning, comfort and whether buying something is necessary at all.
        </p>
      </div>
      <div class="card">
        <p class="eyebrow">Learn more</p>
        <h2>Clear about what earns a place</h2>
        <p>
          Read how we choose topics, handle product claims and decide when a recommendation
          would genuinely help.
        </p>
        <div class="button-row">
          <a class="button" href="/how-we-select-products/">How We Select</a>
          <a class="button secondary" href="/editorial-standards/">Editorial Standards</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .spring-section {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 92% 4%, rgba(117, 151, 98, 0.25), transparent 24rem),
      radial-gradient(ellipse at 7% 94%, rgba(212, 160, 23, 0.12), transparent 20rem),
      linear-gradient(135deg, #edf4e6 0%, #f7f3e5 55%, #e3eddc 100%);
    border-top: 7px solid #78946c;
    border-bottom: 1px solid rgba(63, 77, 63, 0.28);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.72);
  }

  .spring-heading {
    align-items: center;
  }

  .spring-heading > div {
    border-left: 5px solid #78946c;
    padding-left: 18px;
  }

  .spring-season-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 999px;
    padding: 7px 11px;
    background: var(--green-dark);
    color: var(--color-cream);
  }

  .spring-season-label::before {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-wattle);
    content: "";
  }

  .spring-lead-card {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
    overflow: hidden;
    border: 1px solid rgba(48, 79, 55, 0.38);
    border-top: 5px solid #78946c;
    border-radius: 10px;
    background: var(--paper);
    box-shadow: var(--shadow);
    color: var(--ink);
    text-decoration: none;
    transition:
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .spring-lead-card img {
    width: 100%;
    height: 100%;
    min-height: 410px;
    object-fit: cover;
    filter: saturate(1.06) contrast(1.03);
    transition: transform 240ms ease;
  }

  .spring-lead-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(30px, 4vw, 48px);
    background:
      linear-gradient(145deg, rgba(255, 253, 247, 0.99), rgba(226, 238, 217, 0.82));
  }

  .spring-lead-copy h3 {
    margin-bottom: 16px;
    font-size: clamp(2rem, 3.4vw, 3rem);
    line-height: 1.06;
  }

  .spring-lead-copy > p:not(.eyebrow) {
    margin: 0 0 18px;
  }

  .spring-lead-copy .spring-download-note {
    color: var(--green-dark);
    font-size: 0.98rem;
    font-weight: 700;
  }

  .text-link {
    display: inline-flex;
    width: fit-content;
    min-height: 44px;
    align-items: center;
    gap: 10px;
    border-bottom: 2px solid var(--color-wattle);
    color: var(--green-dark);
    font-weight: 800;
  }

  .spring-lead-card:hover {
    box-shadow: 0 20px 46px rgba(31, 42, 33, 0.18);
    color: var(--ink);
    transform: translateY(-2px);
  }

  .spring-lead-card:hover img {
    transform: scale(1.015);
  }

  .spring-lead-card:hover .text-link {
    color: #7a5b05;
  }

  .spring-guide-grid {
    margin-top: 20px;
  }

  .spring-all-guides {
    display: flex;
    justify-content: flex-end;
    margin-top: 20px;
  }

  .home-promise {
    padding-block: 34px;
    background: var(--green-dark);
  }

  .promise-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .promise-item {
    padding: 2px 28px;
  }

  .promise-item + .promise-item {
    border-left: 1px solid rgba(248, 241, 230, 0.24);
  }

  .promise-item:first-child {
    padding-left: 0;
  }

  .promise-item:last-child {
    padding-right: 0;
  }

  .promise-item .eyebrow {
    color: var(--color-wattle);
  }

  .promise-item h2,
  .promise-item p:last-child {
    color: var(--color-cream);
  }

  .promise-item h2 {
    margin-bottom: 8px;
    font-size: clamp(1.3rem, 2vw, 1.65rem);
  }

  .promise-item p:last-child {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.55;
  }

  :global(.grid.home-category-grid) {
    grid-auto-rows: 1fr;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .summer-planning {
    background:
      linear-gradient(180deg, rgba(255, 253, 247, 0.94), rgba(234, 220, 196, 0.38));
  }

  @media (min-width: 1100px) {
    :global(.grid.home-category-grid) {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .home-category-grid :global(.guide-card.has-image a) {
      min-height: 380px;
      padding: 20px 18px;
    }

    .home-category-grid :global(.category-card.has-image h3) {
      font-size: clamp(1.5rem, 1.25rem + 0.45vw, 1.78rem);
      line-height: 1.08;
    }

    .home-category-grid :global(.guide-card p:last-child) {
      font-size: 0.97rem;
      line-height: 1.48;
    }
  }

  @media (max-width: 820px) {
    .spring-lead-card {
      grid-template-columns: 1fr;
    }

    .spring-lead-card img {
      min-height: 300px;
      max-height: 380px;
    }

    .promise-grid {
      grid-template-columns: 1fr;
    }

    .promise-item,
    .promise-item:first-child,
    .promise-item:last-child {
      padding: 20px 0;
    }

    .promise-item + .promise-item {
      border-top: 1px solid rgba(248, 241, 230, 0.24);
      border-left: 0;
    }

    :global(.grid.home-category-grid) {
      grid-template-columns: 1fr;
    }

  }

  @media (max-width: 560px) {
    .spring-lead-copy {
      padding: 26px 22px 30px;
    }

    .spring-lead-card img {
      min-height: 250px;
    }

    .spring-all-guides {
      justify-content: stretch;
    }

    .spring-all-guides .button {
      width: 100%;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .spring-lead-card,
    .spring-lead-card img {
      transition: none;
    }
  }
</style>
