---
import BaseLayout from "./BaseLayout.astro";
import AffiliateDisclosureBlock from "../components/AffiliateDisclosureBlock.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import FAQBlock from "../components/FAQBlock.astro";
import { getCategoryPath } from "../data/categories";
import { getGuideNavigation } from "../data/guideNavigation";
import { getCategorySocialImage } from "../data/socialImages";
import { isCommercialGuide, getApprovedProductsForGuide, getCommercialSectionId } from "../lib/commercial-products";

interface Props {
  title: string;
  seoTitle?: string;
  description: string;
  category: string;
  date: string;
  datePublished?: string;
  dateModified?: string;
  readingTime: string;
  showAffiliateDisclosure?: boolean;
  showDisclosure?: boolean;
  image?: string;
  imageAlt?: string;
  socialImage?: string;
  socialImageAlt?: string;
  imagePosition?: string;
  imagePresentation?: "background" | "product";
  imageCredit?: string;
  articleLabel?: string;
  dateChecked?: string;
  faqs?: Array<{
    question: string;
    answer: string;
  }>;
}

const {
  title,
  seoTitle,
  description,
  category,
  date,
  datePublished,
  dateModified,
  readingTime,
  showAffiliateDisclosure,
  showDisclosure,
  image,
  imageAlt = "",
  socialImage,
  socialImageAlt,
  imagePosition = "center",
  imagePresentation = "background",
  imageCredit,
  articleLabel,
  dateChecked,
  faqs = [],
} = Astro.props;

const shouldShowDisclosure = showAffiliateDisclosure ?? showDisclosure ?? false;
const categorySocialImage = getCategorySocialImage(category);
const resolvedSocialImage = socialImage ?? categorySocialImage.src;
const resolvedSocialImageAlt = socialImageAlt
  ?? (socialImage ? `${title} - Australian Home Collective` : categorySocialImage.alt);
const siteUrl = "https://australianhomecollective.com.au";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const organizationId = `${siteUrl}/#organization`;
const categoryPath = getCategoryPath(category);
const currentPath = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const hasProductOptions = isCommercialGuide(currentPath) && getApprovedProductsForGuide(currentPath).length > 0;
const guideNavigation = getGuideNavigation(currentPath, category, categoryPath);
const breadcrumbItems = categoryPath
  ? [
      { name: "Home", href: "/" },
      { name: "Guides", href: "/guides/" },
      { name: category, href: categoryPath },
      { name: title },
    ]
  : [
      { name: "Home", href: "/" },
      { name: "Guides", href: "/guides/" },
      { name: category },
      { name: title },
    ];
const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "@id": `${canonicalUrl}#breadcrumb`,
  itemListElement: breadcrumbItems.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.name,
    item: new URL(item.href ?? Astro.url.pathname, siteUrl).toString(),
  })),
};
const articleSchema = {
  "@type": "Article",
  "@id": `${canonicalUrl}#article`,
  mainEntityOfPage: { "@id": `${canonicalUrl}#webpage` },
  headline: title,
  description,
  image: new URL(resolvedSocialImage, siteUrl).toString(),
  articleSection: category,
  ...(datePublished ? { datePublished } : {}),
  ...(dateModified ? { dateModified } : {}),
  author: { "@id": organizationId },
  publisher: { "@id": organizationId },
};
const faqSchema = faqs.length > 0 ? {
  "@type": "FAQPage",
  "@id": `${canonicalUrl}#faq`,
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
} : undefined;
const machineReadableDate = date.startsWith("Published")
  ? datePublished
  : dateModified ?? datePublished;
const isGuideRoute = Astro.url.pathname.startsWith("/guides/");
---

<BaseLayout
  title={title}
  seoTitle={seoTitle}
  description={description}
  image={resolvedSocialImage}
  imageAlt={resolvedSocialImageAlt}
  ogType="article"
  searchIndex={isGuideRoute}
  searchCategory={category}
  searchContentType="Guide"
  searchImage={image}
  searchImageAlt={imageAlt}
  structuredData={[breadcrumbSchema, articleSchema, ...(faqSchema ? [faqSchema] : [])]}
>
  <header class:list={["article-header", image && imagePresentation === "background" && "image-header", imagePresentation === "product" && "product-header"]}>
    {image && imagePresentation === "background" && (
      <img
        class="header-image"
        src={image}
        alt={imageAlt}
        width="1600"
        height="720"
        loading="eager"
        draggable="false"
        style={`object-position: ${imagePosition};`}
      />
    )}
    <div class="narrow">
      <Breadcrumbs items={breadcrumbItems} />
      <p class="eyebrow">{category}{articleLabel && <> · {articleLabel}</>}</p>
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      {hasProductOptions && (
        <p class="commercial-product-shortcut">
          <a href={`#${getCommercialSectionId(currentPath)}`}>Jump to our researched options <span aria-hidden="true">↓</span></a>
        </p>
      )}
      <p class="article-meta">
        Published by <a class="article-author" href="/about/">Australian Home Collective</a>
        <span aria-hidden="true"> · </span>
        {machineReadableDate ? <time datetime={machineReadableDate}>{date}</time> : date}
        <span aria-hidden="true"> · </span>{readingTime}
      </p>
      {dateChecked && <p class="article-meta">Date checked: {dateChecked}</p>}
      {shouldShowDisclosure && <AffiliateDisclosureBlock compact />}
    </div>
    {image && imagePresentation === "product" && (
      <figure class="product-figure">
        <img class="header-image" src={image} alt={imageAlt} width="833" height="1000" loading="eager" decoding="async" />
        {imageCredit && <figcaption>{imageCredit}</figcaption>}
      </figure>
    )}
  </header>
  <article class="content narrow">
    <slot />
    {faqs.length > 0 && <FAQBlock items={faqs} />}
    {guideNavigation.isActive && (
      <nav class="guide-navigation" aria-label="Guide navigation">
        {guideNavigation.previous && (
          <div class="guide-navigation-item guide-navigation-previous">
            <span>Previous guide</span>
            <a href={guideNavigation.previous.href}>&larr; {guideNavigation.previous.title}</a>
          </div>
        )}
        <a class="guide-navigation-category" href={guideNavigation.categoryHref}>
          Back to {category} guides
        </a>
        {guideNavigation.next && (
          <div class="guide-navigation-item guide-navigation-next">
            <span>Next guide</span>
            <a href={guideNavigation.next.href}>{guideNavigation.next.title} &rarr;</a>
          </div>
        )}
      </nav>
    )}
  </article>
</BaseLayout>

<style is:global>
  .article-header.product-header { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(240px, 1fr); gap: 36px; align-items: center; padding: 40px max(24px, calc((100vw - 1180px) / 2)); background: #f3f3ec; }
  .product-header .narrow { width: 100%; max-width: none; margin: 0; padding: 0; }
  .product-header h1 { font-size: clamp(2rem, 3.2vw, 3.4rem); }
  .product-figure { margin: 0; text-align: center; }
  .product-header .header-image { position: static; display: block; width: 100%; height: 470px; object-fit: contain; filter: none; }
  .product-figure figcaption { margin-top: 12px; font-size: 0.8rem; color: #4a574c; }
  @media (max-width: 760px) {
    .article-header.product-header { grid-template-columns: minmax(0, 1fr); gap: 24px; padding: 28px 20px; }
    .product-header .header-image { height: 360px; }
  }
</style>
