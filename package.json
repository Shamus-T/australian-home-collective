{
  "name": "australian-home-collective",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run test:commercial-audit && npm run audit:commercial && npm run test:search-analytics && astro build && npm run index:search && npm run audit:search:content && node scripts/audit-site-output.mjs && node scripts/audit-editorial-standards.mjs && node scripts/audit-featured-guide-images.mjs && node scripts/audit-guide-navigation.mjs && node scripts/audit-category-consistency.mjs && node scripts/audit-continue-exploring.mjs && node scripts/audit-seasonal-visuals.mjs && npm run audit:search:dist && npm run audit:commercial:dist",
    "index:search": "pagefind",
    "audit:search:content": "node scripts/audit-pagefind-content.mjs",
    "audit:search:dist": "node scripts/audit-pagefind-output.mjs",
    "audit:site:dist": "node scripts/audit-site-output.mjs",
    "audit:editorial:dist": "node scripts/audit-editorial-standards.mjs",
    "audit:featured-images": "node scripts/audit-featured-guide-images.mjs",
    "audit:guide-navigation": "node scripts/audit-guide-navigation.mjs",
    "audit:categories": "node scripts/audit-category-consistency.mjs",
    "audit:continue-exploring": "node scripts/audit-continue-exploring.mjs",
    "audit:seasonal-visuals": "node scripts/audit-seasonal-visuals.mjs",
    "audit:commercial": "node scripts/audit-commercial-data.mjs",
    "audit:commercial:dist": "node scripts/audit-commercial-data.mjs --dist",
    "test:commercial-audit": "node --test tests/commercial-audit.test.mjs",
    "test:contact": "node --test tests/contact-function.test.mjs",
    "test:search-analytics": "node --test tests/search-analytics.test.mjs tests/search-analytics-client.test.mjs",
    "sitemap:update": "node scripts/update-sitemap-lastmod.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^7.0.6"
  },
  "devDependencies": {
    "entities": "^4.5.0",
    "pagefind": "^1.5.2",
    "ultrahtml": "^1.6.0"
  }
}
